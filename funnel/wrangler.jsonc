{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The public funnel: subscribe -> survey -> VSL + booking -> booked.
  // Separate from rollout-crm on purpose: this one is open to the internet,
  // the CRM stays behind Cloudflare Access. Both share one database.
  "name": "rollout-funnel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",

  // The pages are plain files built by Vite into dist/. Cloudflare serves them
  // straight from its edge; only /api/* wakes the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },

  // The CRM's database. Same database_id as rollout-crm's wrangler.jsonc, so
  // every subscriber, answer and booking lands in one place. The schema is
  // owned by the rollout-crm repo (its migrations/ folder), not this one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rollout-crm",
      "database_id": "f3a02e68-418a-4566-aed0-a8d6b5c6eeac"
    }
  ],

  // No cron here on purpose: the free Workers plan allows 5 per account and
  // the other Workers use them all. Failed beehiiv signups are retried as
  // visitors come through instead (worker/beehiiv.ts, retryBeehiivSoon).

  // Served at rollout-funnel.<account>.workers.dev. Said explicitly so deploys
  // don't warn about the defaults.
  "workers_dev": true,
  "preview_urls": true,

  // The funnel's own domain. Listing both here means every deploy keeps them,
  // and Cloudflare creates the DNS records and certificates itself.
  "routes": [
    { "pattern": "therollout.ai", "custom_domain": true },
    { "pattern": "www.therollout.ai", "custom_domain": true }
  ],

  // Keep variables added in the dashboard. Without this, every deploy resets
  // them to what's in this file, which wiped a plain-text BEEHIIV_API_KEY once.
  // (Secrets are never touched by deploys; keys belong there anyway.)
  "keep_vars": true,

  // Identifiers, not credentials. The one secret, BEEHIIV_API_KEY, is set in
  // the dashboard (Settings > Variables and Secrets), never in this file.
  "vars": {
    "BEEHIIV_PUBLICATION_ID": "pub_b6872449-a6e2-478d-ac5f-5da7935929cb"
  },

  "observability": { "enabled": true }
}
